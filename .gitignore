node_modules/
dist/

# Bun / editor noise
.DS_Store
*.swp

# The PocketJS submodule builds its wasm backend into its own gitignored
# hosts/web/pocketjs.wasm; ignore any stray build receipt here too.

# desktop build plans (tools/desktop.ts)
.pocket/

# Procedural test-fixture art, written by the fixture's gen-assets.ts on
# every `bun run build:example`.
tests/fixtures/*/assets/
# The save/load fixture copies Sunstone's image metadata with its art.
tests/fixtures/ks2-save/images.json

# Wander look frames are generated in memory by examples/wander/look-assets.ts
# (a pure function of base/palette/pose/facing); the shipped artifacts are the
# CLUT8 tilesets under examples/wander/assets/look/tilesets/. Never commit the
# per-frame PNGs.
examples/wander/assets/look/b[0-9][0-9]/

# Downloaded font sources (tools/cjk-font.ts)
.cache/

# Throwaway mutant of the verifier built by the reverse self-test.
tools/.studio-verify-reverse-mutant.ts

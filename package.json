{
  "name": "pocket-rpgkit",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Reusable 2D tile-RPG runtime and rpgkit-project/v1 format for PocketJS",
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine/index.ts",
    "./ui": "./src/ui/index.ts",
    "./ui/image": "./src/ui/image.ts",
    "./ui/choice-icons": "./src/ui/ChoiceIconBox.tsx",
    "./ui/item-icons": "./src/ui/ItemIconRow.tsx",
    "./ui/parallax": "./src/ui/ParallaxLayer.tsx",
    "./ui/battle": "./src/ui/battle/index.ts",
    "./ui/demo": "./src/ui/demo/index.ts",
    "./ui/world": "./src/ui/world/index.ts",
    "./ui/saves": "./src/ui/session-saves.ts",
    "./ui/audio": "./src/ui/audio/index.ts",
    "./ui/krm2": "./src/ui/krm2/index.ts",
    "./host": "./src/host/index.ts",
    "./editor-api": "./editor/api/index.ts",
    "./schema": "./src/data/schema.json"
  },
  "workspaces": [
    "vendor/pocketjs"
  ],
  "scripts": {
    "setup": "git submodule update --init && bun install",
    "test": "bun test tests/",
    "tsc": "bunx tsc --noEmit",
    "gen-assets": "bun examples/showcase/gen-assets.ts && bun examples/meadow/gen-assets.ts && bun examples/sunstone/gen-assets.ts && bun examples/grow/gen-assets.ts && bun editor/gen-assets.ts && bun tools/preview/gen-assets.ts",
    "build:example": "bun tools/build-example.ts",
    "build:editor": "bun tools/build-example.ts editor",
    "build:wasm": "bun vendor/pocketjs/tools/wasm.ts",
    "check": "bun test && bunx tsc --noEmit",
    "desktop": "bun tools/desktop.ts",
    "rpgkit-check": "bun tools/rpgkit-check/cli.ts",
    "package:macos": "bun tools/package-macos.ts",
    "editor": "bun tools/editor.ts",
    "rpgkit-edit": "bun tools/rpgkit-edit/cli.ts",
    "rpgkit-edit:mcp": "bun tools/rpgkit-edit/mcp.ts",
    "web": "bun tools/web.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@vue-jsx-vapor/runtime": "3.2.19",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@pocketjs/framework": "workspace:*",
    "solid-js": "^1.9"
  }
}
